// Neo4j 5.26. Учебные вымышленные персонажи. MERGE допускает повторный запуск.
CREATE CONSTRAINT lab_entity_id IF NOT EXISTS FOR (n:LabEntity) REQUIRE n.id IS UNIQUE;
MERGE (n:LabEntity:Person {id:"p01"}) SET n.name="Mike",n.age=25,n.role="student",n.city="Москва",n.source="educational_example";
MERGE (n:LabEntity:Person {id:"p02"}) SET n.name="Anna",n.age=24,n.role="student",n.city="Москва",n.source="educational_example";
MERGE (n:LabEntity:Person {id:"p03"}) SET n.name="Alex",n.age=22,n.role="student",n.city="Москва",n.source="educational_example";
MERGE (n:LabEntity:Person {id:"p04"}) SET n.name="Ирина",n.age=23,n.role="student",n.city="Москва",n.source="educational_example";
MERGE (n:LabEntity:Person {id:"p05"}) SET n.name="Павел",n.age=21,n.role="student",n.city="Москва",n.source="educational_example";
MERGE (n:LabEntity:Person {id:"p06"}) SET n.name="Мария",n.age=24,n.role="student",n.city="Москва",n.source="educational_example";
MERGE (n:LabEntity:Person {id:"p07"}) SET n.name="Олег",n.age=35,n.role="teacher",n.city="Москва",n.source="educational_example";
MERGE (n:LabEntity:Person {id:"p08"}) SET n.name="Елена",n.age=32,n.role="teacher",n.city="Москва",n.source="educational_example";
MERGE (n:LabEntity:Person {id:"p09"}) SET n.name="Дмитрий",n.age=29,n.role="graduate",n.city="Москва",n.source="educational_example";
MERGE (n:LabEntity:Person {id:"p10"}) SET n.name="София",n.age=27,n.role="graduate",n.city="Москва",n.source="educational_example";
MERGE (n:LabEntity:Movie {id:"m01"}) SET n.title="The Matrix",n.year=1999;
MERGE (n:LabEntity:Movie {id:"m02"}) SET n.title="The Terminator",n.year=1984;
MERGE (n:LabEntity:Community {id:"g01"}) SET n.name="Учебное сообщество",n.topic="education";
MERGE (n:LabEntity:Community {id:"g02"}) SET n.name="Сообщество выпускников",n.topic="education";
MATCH (a:LabEntity {id:"p01"}),(b:LabEntity {id:"p02"}) MERGE (a)-[r:FRIENDS]->(b) SET r.since="2024-09-01",r.strength=3;
